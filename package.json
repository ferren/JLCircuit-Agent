{
  "name": "jlcircuit-agent",
  "version": "0.1.0",
  "private": true,
  "description": "嘉立创智能电路助手：本地 EDA 扩展与 Agent 编排服务",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "extensions/*"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-strip-types apps/agent-service/src/server.ts",
    "start": "node --env-file-if-exists=.env --experimental-strip-types apps/agent-service/src/server.ts",
    "build:extension": "npm --workspace @jlcircuit/eda-extension run build",
    "test": "node --test --test-isolation=none --experimental-strip-types apps/agent-service/src/storage.test.ts apps/agent-service/src/context-engine.test.ts apps/agent-service/src/skill-registry.test.ts apps/agent-service/src/mcp-registry.test.ts apps/agent-service/src/knowledge-service.test.ts apps/agent-service/src/llm.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "pdfjs-dist": "^6.2.108",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  }
}
