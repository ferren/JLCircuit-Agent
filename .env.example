JLCIRCUIT_AGENT_HOST=127.0.0.1
JLCIRCUIT_AGENT_PORT=49630
JLCIRCUIT_BRIDGE_TOKEN=change-me
# SQLite persistence. Relative paths are resolved from the service working directory.
JLCIRCUIT_DB_PATH=.jlcircuit-data/jlcircuit-agent.sqlite
# Conversation Context Engine budgets.
JLCIRCUIT_CONTEXT_RECENT_MESSAGES=12
JLCIRCUIT_CONTEXT_HISTORY_MAX_CHARS=12000
JLCIRCUIT_CONTEXT_SUMMARY_MAX_CHARS=6000
JLCIRCUIT_CONTEXT_ACTIVE_TASKS=5
JLCIRCUIT_CONTEXT_TASK_MAX_CHARS=6000
# Declarative skills. Separate multiple roots with the OS path delimiter (; on Windows, : on Linux/macOS).
JLCIRCUIT_SKILL_ROOTS=
JLCIRCUIT_SKILL_AUTO_ACTIVATE=true
JLCIRCUIT_SKILL_MAX_ACTIVE=3
JLCIRCUIT_SKILL_MAX_INSTRUCTION_CHARS=20000
# MCP Gateway. Copy config/mcp-servers.example.json to the ignored data directory before enabling servers.
JLCIRCUIT_MCP_CONFIG=.jlcircuit-data/mcp-servers.json
JLCIRCUIT_MCP_AUTO_CONNECT=true
JLCIRCUIT_MCP_REQUEST_TIMEOUT_MS=15000
JLCIRCUIT_MCP_MAX_SERVERS=16
JLCIRCUIT_MCP_MAX_TOOLS_PER_SERVER=100
JLCIRCUIT_MCP_MAX_TOOL_SCHEMA_CHARS=20000
JLCIRCUIT_MCP_MAX_RESULT_CHARS=1000000
# Optional protection shared by MCP and Local Knowledge management APIs. The EDA manager asks for this value per session.
JLCIRCUIT_ADMIN_TOKEN=
# Additional comma-separated origins. The Agent's own 127.0.0.1/localhost/[::1] origins are allowed automatically.
JLCIRCUIT_ADMIN_ALLOWED_ORIGINS=
# Backward-compatible MCP-only aliases; the generic values above take precedence.
JLCIRCUIT_MCP_ADMIN_TOKEN=
JLCIRCUIT_MCP_ADMIN_ALLOWED_ORIGINS=
# Local Knowledge ingestion and chunking limits.
JLCIRCUIT_KNOWLEDGE_MAX_FILES=5000
JLCIRCUIT_KNOWLEDGE_MAX_FILE_BYTES=26214400
JLCIRCUIT_KNOWLEDGE_MAX_PDF_PAGES=1000
JLCIRCUIT_KNOWLEDGE_MAX_DEPTH=12
JLCIRCUIT_KNOWLEDGE_CHUNK_CHARS=4000
JLCIRCUIT_KNOWLEDGE_CHUNK_OVERLAP=300
# Agent runtime. codex-app-server is the primary backend; legacy keeps the previous in-process Chat Completions loop.
JLCIRCUIT_AGENT_BACKEND=codex-app-server
# Codex App Server provider process pool. Copy config/codex-providers.example.json to this ignored path.
JLCIRCUIT_CODEX_COMMAND=codex
JLCIRCUIT_CODEX_PROVIDERS_CONFIG=.jlcircuit-data/codex-providers.json
JLCIRCUIT_CODEX_HOME_ROOT=.jlcircuit-data/codex-home
JLCIRCUIT_CODEX_MAX_PROCESSES=4
JLCIRCUIT_CODEX_REQUEST_TIMEOUT_MS=30000
# Provider secrets are read from the environment named by apiKeyEnv; never put key values in the JSON file.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Legacy backend and missing-provider compatibility values. These are also used to synthesize one Codex provider
# when JLCIRCUIT_CODEX_PROVIDERS_CONFIG does not exist and JLCIRCUIT_MODEL_PROVIDER is not stub.
JLCIRCUIT_MODEL_PROVIDER=stub
JLCIRCUIT_LLM_BASE_URL=https://api.openai.com/v1
JLCIRCUIT_LLM_API_KEY=
JLCIRCUIT_LLM_MODEL=gpt-4o-mini
# true: screenshots are sent to JLCIRCUIT_LLM_MODEL; false: use the separate vision model below
JLCIRCUIT_LLM_SUPPORTS_VISION=false
JLCIRCUIT_VISION_LLM_BASE_URL=https://api.openai.com/v1
JLCIRCUIT_VISION_LLM_API_KEY=
JLCIRCUIT_VISION_LLM_MODEL=gpt-4o-mini
JLCIRCUIT_VISION_LLM_TIMEOUT_MS=120000
JLCIRCUIT_LLM_TIMEOUT_MS=60000
JLCIRCUIT_LLM_MAX_TOKENS=4096
# Stream reasoning/content/tool progress. OpenRouter returns exact usage in the final SSE chunk.
JLCIRCUIT_LLM_STREAMING=true
# Enable streamed Function Call deltas. Defaults to true for provider=zai and false for other providers.
JLCIRCUIT_LLM_TOOL_STREAM=
# Optional: low/minimal/medium/high etc. Leave empty to use the model/provider default.
JLCIRCUIT_LLM_REASONING_EFFORT=
# Used by budget summaries and automatic recovery after finish_reason=length.
JLCIRCUIT_LLM_FINAL_REASONING_EFFORT=minimal
JLCIRCUIT_LLM_MAX_LENGTH_RECOVERIES=1
JLCIRCUIT_LLM_CONTEXT_MAX_CHARS=40000
JLCIRCUIT_LLM_CONTEXT_MAX_ITEMS=200
# Maximum serialized size of one tool result sent back to the model. Oversized results are summarized with a scoped-query hint.
JLCIRCUIT_LLM_TOOL_RESULT_MAX_CHARS=50000
# Goal-driven agent loop safety budgets. These are fuses, not completion criteria.
# Total fail-safe only. Duplicate/no-progress actions are stopped immediately.
JLCIRCUIT_AGENT_MAX_TOOL_CALLS=120
JLCIRCUIT_AGENT_MAX_ELAPSED_MS=300000
JLCIRCUIT_AGENT_MAX_NO_PROGRESS=2
JLCIRCUIT_AGENT_MAX_RETRIES_PER_ACTION=2
JLCIRCUIT_AGENT_FINALIZE_TIMEOUT_MS=60000
# Write-tool approval mode: "inline" pauses the turn and asks the user to approve each write
# in real time (falls back to the ChangeSet flow when no stream is available or on timeout);
# "changeset" always defers writes into a ChangeSet that is confirmed after the turn.
JLCIRCUIT_WRITE_APPROVAL_MODE=inline
JLCIRCUIT_WRITE_APPROVAL_TIMEOUT_MS=180000
